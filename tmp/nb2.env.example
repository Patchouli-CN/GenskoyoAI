# ===== nb2 适配器配置（适配器私有配置目录约定）=====
# 用法：复制本文件到 config/nb2/local.env 后按需修改（首次运行也会自动
# 从本模板播种生成）——config/{adapter_name}/ 是各适配器的私有配置目录
# （框架只约定目录，格式与加载器归适配器自己）；项目根 .env 仍兜底读取
# （会打迁移提示）。

# ===== NoneBot 框架自身配置 =====
# 反向 WebSocket（推荐）需要 ASGI 驱动器
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
# 若协议端（NapCat）侧配置了 access token，这里保持一致
#ONEBOT_ACCESS_TOKEN=

# ===== GensokyoAI 适配器配置 =====
# 默认角色（characters/ 或 characters/zh_cn/ 下的角色名）
GSK_NB2_CHARACTER=KirisameMarisa
# 适配器数据目录（群→会话映射表）
GSK_NB2_DATA_DIR=nb2_data
# GensokyoAI 项目根目录（characters/ 与 config/ 的解析基准）；留空 = 当前工作目录
#GSK_NB2_ROOT_DIR=
# 角色主动发言（经进程内事件订阅实时投递）；false 则停用各租户主动定时器
GSK_NB2_INITIATIVE=true
# 回复按行拆成多条短消息发送（QQ 群聊风格；配合 GSK_NB2_EXTRA_PROMPT 的按行要求）
GSK_NB2_SPLIT_REPLY=true
# 发送前清洗 RP 风格标记（*动作* 描写、「」台词引号），确定性生效、不依赖模型配合
GSK_NB2_STRIP_RP_STYLE=true
# 群聊消息注入【昵称】说话人标记（多对单会话的归属，私聊不标）；昵称经注入净化
GSK_NB2_SENDER_LABEL=true
# 群友印象：首轮交谈后由角色生成第一印象并存入 known_members.json，之后随消息注入
GSK_NB2_MEMBER_MEMORY=true
# OWNER 级指令白名单（四级权限模型 VISITOR<USER<ADMIN<OWNER 的最高级，逗号分隔）
#GSK_NB2_OWNER_QQ=你的QQ号
# 随每条回复注入的附加要求（风格/约束，只影响当轮回复、不写入会话）。
# 留空则使用内置默认值：「QQ 群聊风格：简短口语化、每句话单独一行、不要动作描写、最多三句」
#GSK_NB2_EXTRA_PROMPT=
# 群白名单，逗号分隔；留空表示响应所有群
#GSK_NB2_GROUP_WHITELIST=123456789,987654321
# 群白名单，逗号分隔；留空表示响应所有群
#GSK_NB2_GROUP_WHITELIST=123456789,987654321

# ===== NapCat 掉线守护 =====
# 账号被踢下线（bot_offline 事件）/ WS 断开超时未回连时：杀 NapCat 进程树
# （只杀 NapCatWinBootMain 及其子孙，不碰个人 QQ）→ 带 QQ 号快速登录重连。
# 节制：冷却 + 每日上限，超限或回连超时写 nb2_data/napcat_offline_alert.json 告警停手。
GSK_NB2_WATCHDOG=true
# NapCat.Shell 目录（相对 GSK_NB2_ROOT_DIR/当前目录或绝对路径）
#GSK_NB2_NAPCAT_DIR=ignore/NapCat.Shell
# 两次自动重启的最小间隔（秒）
#GSK_NB2_WATCHDOG_COOLDOWN=600
# 24h 内自动重启上限
#GSK_NB2_WATCHDOG_MAX_RESTARTS=5
# 重启后等待回连的超时（秒），超时告警（可能需重新扫码）；冷启动实测可达 6+ 分钟
#GSK_NB2_WATCHDOG_RECOVER_TIMEOUT=900
# WS 断开的回连宽限期（秒），NapCat 自己重连上就不动它
#GSK_NB2_WATCHDOG_DISCONNECT_GRACE=60
# 掉线守护快速登录用的 bot QQ 号（硬编码 launcher-win10-user.bat -q <QQ号>，
# 不依赖 main.bat）；留空则由首次协议连接的 self_id 兜底
#GSK_NB2_BOT_QQ=3779163297

# ===== 到点提醒 =====
# 角色经 set_reminder 工具接活（"10 分钟后提醒我吃饭"），到点用自己的口吻
# 生成提醒文本并 @ 对方投递；nb2_data/reminders.json 持久化（重启不丢），
# 30s tick 扫到点项，失败重试约 20 分钟后放弃。
GSK_NB2_REMINDERS=true
# 每个群/私聊的待办提醒上限（防滥用烧 token）
#GSK_NB2_REMINDER_MAX_PER_TENANT=20
